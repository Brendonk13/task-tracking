# Copy to backend/.env and fill in. Nothing here has a fallback: a missing value
# makes the cron step that needs it skip, with a `cron_error` alert naming it.

# Anthropic key, used by the backend's own LLM calls.
ANTHROPIC_API_KEY=

# Linear personal API key (Settings -> Security & access -> Personal API keys).
# Used read-only: the backend only ever sends GraphQL queries.
LINEAR_API_KEY=
# Active issues assigned to this person become tickets.
LINEAR_ASSIGNEE_EMAIL=brendon.keirle@avantos.ai

# GitHub login whose open PRs are imported. Comments by this login count as answers.
GITHUB_USER=Brendonk13
# Comma separated "owner/repo" list.
GITHUB_REPOS=mosaic-avantos/avantos
# Local checkout per repo, "repo=path;repo=path". A PR's sessions run here.
REPO_DIRS=mosaic-avantos/avantos=/home/brendon/Documents/work/Jobs/avantos/code/worktrees/0_main

# Where /ticket-brief writes its briefs.
BRIEFS_DIR=/home/brendon/ticket-briefs
# Claude Code executable and the limits every spawned session runs under.
CLAUDE_BIN=claude
CLAUDE_SESSION_TIMEOUT_SECONDS=1800
CLAUDE_MAX_BUDGET_USD=5
# Headless sessions one cron run may spawn (briefs and triage share this budget).
CRON_MAX_SESSIONS_PER_RUN=3
# Scratch space for cron workers: logs and triage analysis JSON.
CRON_WORK_DIR=var
